          "entrypoint_candidates": {"type": "array", "description": "Hostname-shaped candidates kept as non-entrypoint supporting evidence with classification and reason. Cut to the 50-row cap on the context routes; result_limits.entrypoint_candidate_count carries the total and partial_reasons names the cut entrypoint_candidates_truncated.", "items": {"type": "object"}},
