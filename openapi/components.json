          "network_paths": {"type": "array", "description": "Entrypoint-to-runtime paths, one per entrypoint that matches a runtime instance, capped at 50 rows. result_limits.network_path_count reports the total before the cut; a cut sets result_limits.truncated and adds network_paths_truncated to partial_reasons.", "items": {"type": "object"}},
